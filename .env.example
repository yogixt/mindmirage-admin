ADMIN_EMAILS=
ADMIN_PASSWORD=
AUTH_SECRET=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
RESEND_API_KEY=

# WhatsApp Cloud API (optional — welcome + booking confirmations)
# 1. Go to https://developers.facebook.com → WhatsApp → get a Phone Number ID
# 2. Generate a permanent access token
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
# Phone number for admin welcome notifications (with country code, e.g. 917302431279)
ADMIN_WHATSAPP=

# Payment reconciliation — the "Reconcile payments" button on Orders sweeps
# mindmirage's Razorpay history for anything the webhook missed. Must be the
# SAME value as RECONCILE_API_KEY in mindmirage's own env.
RECONCILE_API_KEY=

# Kutir AI Assistant — the /assistant page's database co-pilot. Get a key at
# https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=
